{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Graffin Studio",
  "version": "2.4.0",
  "identifier": "com.barsik.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Graffin Studio",
        "width": 1330,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 720,
        "center": true,
        "backgroundColor": "#101113"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost; font-src 'self' data: asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": [
      "resources/*"
    ],
    "category": "Video",
    "shortDescription": "Локальная пакетная сборка вертикальных видео",
    "macOS": {
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-"
    }
  }
}
